<?xml version='1.0' encoding='utf-8'?>
<workflow>
  <name>wf_extracao_dimensoes</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Extração de tabelas brutas do Firebird para staging</description>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <parallel>N</parallel>
      <xloc>60</xloc>
      <yloc>160</yloc>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
    </action>
    <action>
      <name>Extrair CIDADE</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_cidade.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair CLASSIFICACAO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>440</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_classificacao.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair COLECAO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_colecao.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair COR</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>840</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_cor.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair FAMILIA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1040</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_familia.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair GRUPO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>310</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_grupo.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair ITEM</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>440</xloc>
      <yloc>310</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_item.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair ITEM_DETALHE</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>310</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_item_detalhe.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair LINHA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>840</xloc>
      <yloc>310</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_linha.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair ORGAO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1040</xloc>
      <yloc>310</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_orgao.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair ORIGEM</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>460</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_origem.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair PESSOA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>440</xloc>
      <yloc>460</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_pessoa.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair PESSOA_CLIENTE</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>460</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_pessoa_cliente.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair PESSOA_CONSULTORVENDAS</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>840</xloc>
      <yloc>460</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_pessoa_consultorvendas.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair PESSOA_ENDERECO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1040</xloc>
      <yloc>460</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_pessoa_endereco.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair REGIAO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>610</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_regiao.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair STATUS</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>440</xloc>
      <yloc>610</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_status.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair SUBGRUPO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>610</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_subgrupo.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair TIPOPRODUTO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>840</xloc>
      <yloc>610</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_tipoproduto.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair UF</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1040</xloc>
      <yloc>610</yloc>
      <filename>${PROJECT_HOME}/pipelines/extracao/dimensoes/ext_uf.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>760</yloc>
    </action>
    <action>
      <name>Abortar</name>
      <type>ABORT</type>
      <parallel>N</parallel>
      <xloc>850</xloc>
      <yloc>960</yloc>
      <message>Carga interrompida; consulte o log. Publicação é transacional.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Extrair CIDADE</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Extrair CIDADE</from>
      <to>Extrair CLASSIFICACAO</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Extrair CIDADE</from>
      <to>Abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Extrair CLASSIFICACAO</from>
      <to>Extrair COLECAO</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Extrair CLASSIFICACAO</from>
      <to>Abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Extrair COLECAO</from>
      <to>Extrair COR</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
