<?xml version='1.0' encoding='utf-8'?>
<workflow>
  <name>posvenda_local</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Assistências, cancelamentos de venda e devoluções; publicação isolada e atômica.</description>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>160</yloc>
      <repeat>N</repeat>
    </action>
    <action>
      <name>Preparar pós-venda</name>
      <type>SQL</type>
      <parallel>N</parallel>
      <xloc>260</xloc>
      <yloc>160</yloc>
      <connection>DW</connection>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/posvenda/001_preparar.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
    </action>
    <action>
      <name>Extrair DOCUMENTO_FATURA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>440</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_fatura.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair DOCUMENTO_ITEM</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>620</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_item.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair DOCUMENTO_ITEM_DETALHE</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_item_detalhe.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair DOCUMENTO_DEVOLUCAOCANCELA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>980</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_devolucaocancela.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair DOCUMENTO_ENTREGA_DEVCAN</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1160</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_entrega_devcan.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair DOCUMENTO_ENTREGA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1340</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_entrega.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair DOCUMENTO_PEDIDO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1520</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_documento_pedido.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair MOTIVO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1700</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_motivo.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair PESSOA</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>1880</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_pessoa.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair PESSOA_ENDERECO</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>2060</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_pessoa_endereco.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair ITEM</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>2240</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_item.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair CIDADE</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>2420</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_cidade.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
