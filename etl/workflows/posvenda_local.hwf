    </action>
    <action>
      <name>Extrair UF</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>2600</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_uf.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Extrair STATUS</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>2780</xloc>
      <yloc>160</yloc>
      <filename>${PROJECT_HOME}/pipelines/posvenda/ext_posvenda_status.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
    </action>
    <action>
      <name>Validar e publicar</name>
      <type>SQL</type>
      <parallel>N</parallel>
      <xloc>2960</xloc>
      <yloc>160</yloc>
      <connection>DW</connection>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/posvenda/002_publicar.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>3140</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Abortar</name>
      <type>ABORT</type>
      <parallel>N</parallel>
      <xloc>3320</xloc>
      <yloc>160</yloc>
      <message>Carga pós-venda interrompida. Publicação anterior preservada.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Preparar pós-venda</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Preparar pós-venda</from>
      <to>Extrair DOCUMENTO_FATURA</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Preparar pós-venda</from>
      <to>Abortar</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
