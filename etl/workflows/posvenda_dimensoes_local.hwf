<?xml version="1.0" encoding="UTF-8"?>
<workflow>
 <name>posvenda_dimensoes_local</name><name_sync_with_filename>Y</name_sync_with_filename>
 <description>Publicação atômica de dimensões de pós-venda a partir dos espelhos reais já extraídos pelo Hop.</description>
 <actions>
  <action><name>Start</name><type>SPECIAL</type><parallel>N</parallel><repeat>N</repeat><xloc>80</xloc><yloc>160</yloc></action>
  <action><name>Publicar dimensões</name><type>SQL</type><parallel>N</parallel><connection>DW</connection><sqlfromfile>Y</sqlfromfile><sqlfilename>${PROJECT_HOME}/sql/posvenda/003_dimensoes.sql</sqlfilename><sqlfilename_encoding>UTF-8</sqlfilename_encoding><useVariableSubstitution>Y</useVariableSubstitution><sendOneStatement>Y</sendOneStatement><xloc>260</xloc><yloc>160</yloc></action>
  <action><name>Success</name><type>SUCCESS</type><parallel>N</parallel><xloc>440</xloc><yloc>160</yloc></action>
  <action><name>Abortar</name><type>ABORT</type><parallel>N</parallel><message>Dimensões não publicadas; versão anterior preservada.</message><xloc>440</xloc><yloc>300</yloc></action>
 </actions>
 <hops>
  <hop><from>Start</from><to>Publicar dimensões</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
  <hop><from>Publicar dimensões</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  <hop><from>Publicar dimensões</from><to>Abortar</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
 </hops>
</workflow>
