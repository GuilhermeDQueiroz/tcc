<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>load_modelo_analitico</name>
    <description>Publicação atômica: staging → dimensões e fatos dw. SQL idêntico a sql/003_publicacao.sql.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>10000</size_rowset>
  </info>
  <order />
  <transform>
    <name>Publicar dimensões e fatos em uma transação</name>
    <type>ExecSql</type>
    <copies>1</copies>
    <connection>DW</connection>
    <sql>BEGIN;

SELECT pg_advisory_xact_lock(741083, 1);

DELETE FROM dw.fato_abertos;

DELETE FROM dw.fato_emitidos;

DELETE FROM dw.fato_faturados;

DELETE FROM dw.dim_cliente;

INSERT INTO dw.dim_cliente SELECT DISTINCT * FROM (SELECT md5(jsonb_build_array("cliente_docfat", "razaosocial_pessoa", "grupo_cliente_descricao")::text) AS id, "cliente_docfat" AS "cliente_docfat", "razaosocial_pessoa" AS "razaosocial_pessoa", "grupo_cliente_descricao" AS "grupo_cliente_descricao" FROM dw.carga_abertos UNION ALL SELECT md5(jsonb_build_array("cliente_docfat", "razaosocial_pessoa", "grupo_cliente_descricao")::text) AS id, "cliente_docfat" AS "cliente_docfat", "razaosocial_pessoa" AS "razaosocial_pessoa", "grupo_cliente_descricao" AS "grupo_cliente_descricao" FROM dw.carga_emitidos UNION ALL SELECT md5(jsonb_build_array("cliente_docfat", "razaosocial_pessoa", "grupo_cliente_descricao")::text) AS id, "cliente_docfat" AS "cliente_docfat", "razaosocial_pessoa" AS "razaosocial_pessoa", "grupo_cliente_descricao" AS "grupo_cliente_descricao" FROM dw.carga_faturados) src;

DELETE FROM dw.dim_comercial;

INSERT INTO dw.dim_comercial SELECT DISTINCT * FROM (SELECT md5(jsonb_build_array("consultor_descricao", "supervisor_descricao", "descricao_origem", "descricao_orgao", "descricao_status", "descricao_classif", "tipo_entrega")::text) AS id, "consultor_descricao" AS "consultor_descricao", "supervisor_descricao" AS "supervisor_descricao", "descricao_origem" AS "descricao_origem", "descricao_orgao" AS "descricao_orgao", "descricao_status" AS "descricao_status", "descricao_classif" AS "descricao_classif", "tipo_entrega" AS "tipo_entrega" FROM dw.carga_abertos UNION ALL SELECT md5(jsonb_build_array("consultor_descricao", "supervisor_descricao", "descricao_origem", "descricao_orgao", "descricao_status", "descricao_classif", "tipo_entrega")::text) AS id, "consultor_descricao" AS "consultor_descricao", "supervisor_descricao" AS "supervisor_descricao", "descricao_origem" AS "descricao_origem", "descricao_orgao" AS "descricao_orgao", "descricao_status" AS "descricao_status", "descricao_classif" AS "descricao_classif", "tipo_entrega" AS "tipo_entrega" FROM dw.carga_emitidos UNION ALL SELECT md5(jsonb_build_array("consultor_descricao", "supervisor_descricao", "descricao_origem", "descricao_orgao", "descricao_status", "descricao_classif", "tipo_entrega")::text) AS id, "consultor_descricao" AS "consultor_descricao", "supervisor_descricao" AS "supervisor_descricao", "descricao_origem" AS "descricao_origem", "descricao_orgao" AS "descricao_orgao", "descricao_status" AS "descricao_status", "descricao_classif" AS "descricao_classif", "tipo_entrega" AS "tipo_entrega" FROM dw.carga_faturados) src;

DELETE FROM dw.dim_geografia;

INSERT INTO dw.dim_geografia SELECT DISTINCT * FROM (SELECT md5(jsonb_build_array("sigla_uf", "regiao_uf_descricao", "descricao_regiao", "descricao_cidade")::text) AS id, "sigla_uf" AS "sigla_uf", "regiao_uf_descricao" AS "regiao_uf_descricao", "descricao_regiao" AS "descricao_regiao", "descricao_cidade" AS "descricao_cidade" FROM dw.carga_abertos UNION ALL SELECT md5(jsonb_build_array("sigla_uf", "regiao_uf_descricao", "descricao_regiao", "descricao_cidade")::text) AS id, "sigla_uf" AS "sigla_uf", "regiao_uf_descricao" AS "regiao_uf_descricao", "descricao_regiao" AS "descricao_regiao", "descricao_cidade" AS "descricao_cidade" FROM dw.carga_emitidos UNION ALL SELECT md5(jsonb_build_array("sigla_uf", "regiao_uf_descricao", "descricao_regiao", "descricao_cidade")::text) AS id, "sigla_uf" AS "sigla_uf", "regiao_uf_descricao" AS "regiao_uf_descricao", "descricao_regiao" AS "descricao_regiao", "descricao_cidade" AS "descricao_cidade" FROM dw.carga_faturados) src;

DELETE FROM dw.dim_produto;

INSERT INTO dw.dim_produto SELECT DISTINCT * FROM (SELECT md5(jsonb_build_array("codigo_item", "descricao_item", "cor_descricao", "grupo_item_descricao", "subgrupo_descricao", "tipo_produto_descricao", "colecao_descricao", "linha_descricao", NULL::text)::text) AS id, "codigo_item" AS "codigo_item", "descricao_item" AS "descricao_item", "cor_descricao" AS "cor_descricao", "grupo_item_descricao" AS "grupo_item_descricao", "subgrupo_descricao" AS "subgrupo_descricao", "tipo_produto_descricao" AS "tipo_produto_descricao", "colecao_descricao" AS "colecao_descricao", "linha_descricao" AS "linha_descricao", NULL::text AS "familia_descricao" FROM dw.carga_abertos UNION ALL SELECT md5(jsonb_build_array("codigo_item", "descricao_item", "cor_descricao", "grupo_item_descricao", "subgrupo_descricao", "tipo_produto_descricao", "colecao_descricao", "linha_descricao", NULL::text)::text) AS id, "codigo_item" AS "codigo_item", "descricao_item" AS "descricao_item", "cor_descricao" AS "cor_descricao", "grupo_item_descricao" AS "grupo_item_descricao", "subgrupo_descricao" AS "subgrupo_descricao", "tipo_produto_descricao" AS "tipo_produto_descricao", "colecao_descricao" AS "colecao_descricao", "linha_descricao" AS "linha_descricao", NULL::text AS "familia_descricao" FROM dw.carga_emitidos UNION ALL SELECT md5(jsonb_build_array("codigo_item", "descricao_item", "cor_descricao", "grupo_item_descricao", "subgrupo_descricao", "tipo_produto_descricao", "colecao_descricao", "linha_descricao", "familia_descricao")::text) AS id, "codigo_item" AS "codigo_item", "descricao_item" AS "descricao_item", "cor_descricao" AS "cor_descricao", "grupo_item_descricao" AS "grupo_item_descricao", "subgrupo_descricao" AS "subgrupo_descricao", "tipo_produto_descricao" AS "tipo_produto_descricao", "colecao_descricao" AS "colecao_descricao", "linha_descricao" AS "linha_descricao", "familia_descricao" AS "familia_descricao" FROM dw.carga_faturados) src;

INSERT INTO dw.fato_abertos ("codigo_docfat", "data_emissao_pedido", "dia", "mes", "ano", "nivel_de_servico", "data_previsao_faturamento", "valor_em_aberto", "qtdeaberta_docitemdet", "peso_em_aberto", "volume_m3_em_aberto", "vlrbrutoliquido_docitemdet", "vlrunitariobruto_docitemdet", "vlrunitarioliquido_docitemdet", "valor_unitario_bruto_liquido", "vlrliquido_docfat", "data_emissao_pedido_tratada", "data_previsao_faturamento_tratada", "valor_em_aberto_tratado", "peso_em_aberto_tratado", "quantidade_em_aberto_tratada", "volume_m3_em_aberto_tratado", "nivel_de_servico_tratado", cliente_id, comercial_id, geografia_id, produto_id) SELECT "codigo_docfat", "data_emissao_pedido", "dia", "mes", "ano", "nivel_de_servico", "data_previsao_faturamento", "valor_em_aberto", "qtdeaberta_docitemdet", "peso_em_aberto", "volume_m3_em_aberto", "vlrbrutoliquido_docitemdet", "vlrunitariobruto_docitemdet", "vlrunitarioliquido_docitemdet", "valor_unitario_bruto_liquido", "vlrliquido_docfat", "data_emissao_pedido_tratada", "data_previsao_faturamento_tratada", "valor_em_aberto_tratado", "peso_em_aberto_tratado", "quantidade_em_aberto_tratada", "volume_m3_em_aberto_tratado", "nivel_de_servico_tratado", md5(jsonb_build_array("cliente_docfat", "razaosocial_pessoa", "grupo_cliente_descricao")::text), md5(jsonb_build_array("consultor_descricao", "supervisor_descricao", "descricao_origem", "descricao_orgao", "descricao_status", "descricao_classif", "tipo_entrega")::text), md5(jsonb_build_array("sigla_uf", "regiao_uf_descricao", "descricao_regiao", "descricao_cidade")::text), md5(jsonb_build_array("codigo_item", "descricao_item", "cor_descricao", "grupo_item_descricao", "subgrupo_descricao", "tipo_produto_descricao", "colecao_descricao", "linha_descricao", NULL::text)::text) FROM dw.carga_abertos;

INSERT INTO dw.fato_emitidos ("codigo_docfat", "pessoa_doccom", "data_emissao_pedido", "dia", "mes", "ano", "nivel_de_servico", "data_previsao_faturamento", "vlrbrutoliquido_docitemdet", "qtdechapas_docitemdet", "peso_emitido", "volume_m3_emitido", "vlrunitariobruto_docitemdet", "vlrunitarioliquido_docitemdet", "valor_unitario_bruto_liquido", "vlrliquido_docfat", "data_emissao_pedido_tratada", "data_previsao_faturamento_tratada", "valor_emitido_tratado", "peso_emitido_tratado", "quantidade_emitida_tratada", "volume_m3_emitido_tratado", "nivel_de_servico_tratado", cliente_id, comercial_id, geografia_id, produto_id) SELECT "codigo_docfat", "pessoa_doccom", "data_emissao_pedido", "dia", "mes", "ano", "nivel_de_servico", "data_previsao_faturamento", "vlrbrutoliquido_docitemdet", "qtdechapas_docitemdet", "peso_emitido", "volume_m3_emitido", "vlrunitariobruto_docitemdet", "vlrunitarioliquido_docitemdet", "valor_unitario_bruto_liquido", "vlrliquido_docfat", "data_emissao_pedido_tratada", "data_previsao_faturamento_tratada", "valor_emitido_tratado", "peso_emitido_tratado", "quantidade_emitida_tratada", "volume_m3_emitido_tratado", "nivel_de_servico_tratado", md5(jsonb_build_array("cliente_docfat", "razaosocial_pessoa", "grupo_cliente_descricao")::text), md5(jsonb_build_array("consultor_descricao", "supervisor_descricao", "descricao_origem", "descricao_orgao", "descricao_status", "descricao_classif", "tipo_entrega")::text), md5(jsonb_build_array("sigla_uf", "regiao_uf_descricao", "descricao_regiao", "descricao_cidade")::text), md5(jsonb_build_array("codigo_item", "descricao_item", "cor_descricao", "grupo_item_descricao", "subgrupo_descricao", "tipo_produto_descricao", "colecao_descricao", "linha_descricao", NULL::text)::text) FROM dw.carga_emitidos;

INSERT INTO dw.fato_faturados ("codigo_docfat", "data_emissao_pedido", "dia", "mes", "ano", "nivel_de_servico", "data_previsao_faturamento", "entrega_no_prazo", "dias_desvio_faturamento", "valor_faturado", "qtdechapas_docent", "peso_faturado", "volume_m3_faturado", "carga_cardoc", "descricao_carga", "codigo_docfat_entrega", "dtemissao_docfat", "numeronf_nfdocumentos", "vlrbrutoliquido_docitemdet", "qtdeaberta_docitemdet", "vlrunitariobruto_docitemdet", "vlrunitarioliquido_docitemdet", "valor_unitario_bruto_liquido", "vlrliquido_docfat", "data_emissao_pedido_tratada", "data_faturamento_tratada", "data_previsao_faturamento_tratada", "valor_faturado_tratado", "peso_faturado_tratado", "quantidade_faturada_tratada", "volume_m3_faturado_tratado", "nivel_de_servico_tratado", "entrega_no_prazo_tratado", "dias_desvio_faturamento_tratado", cliente_id, comercial_id, geografia_id, produto_id) SELECT "codigo_docfat", "data_emissao_pedido", "dia", "mes", "ano", "nivel_de_servico", "data_previsao_faturamento", "entrega_no_prazo", "dias_desvio_faturamento", "valor_faturado", "qtdechapas_docent", "peso_faturado", "volume_m3_faturado", "carga_cardoc", "descricao_carga", "codigo_docfat_entrega", "dtemissao_docfat", "numeronf_nfdocumentos", "vlrbrutoliquido_docitemdet", "qtdeaberta_docitemdet", "vlrunitariobruto_docitemdet", "vlrunitarioliquido_docitemdet", "valor_unitario_bruto_liquido", "vlrliquido_docfat", "data_emissao_pedido_tratada", "data_faturamento_tratada", "data_previsao_faturamento_tratada", "valor_faturado_tratado", "peso_faturado_tratado", "quantidade_faturada_tratada", "volume_m3_faturado_tratado", "nivel_de_servico_tratado", "entrega_no_prazo_tratado", "dias_desvio_faturamento_tratado", md5(jsonb_build_array("cliente_docfat", "razaosocial_pessoa", "grupo_cliente_descricao")::text), md5(jsonb_build_array("consultor_descricao", "supervisor_descricao", "descricao_origem", "descricao_orgao", "descricao_status", "descricao_classif", "tipo_entrega")::text), md5(jsonb_build_array("sigla_uf", "regiao_uf_descricao", "descricao_regiao", "descricao_cidade")::text), md5(jsonb_build_array("codigo_item", "descricao_item", "cor_descricao", "grupo_item_descricao", "subgrupo_descricao", "tipo_produto_descricao", "colecao_descricao", "linha_descricao", "familia_descricao")::text) FROM dw.carga_faturados;

DELETE FROM dw.carteira_clientes;

INSERT INTO dw.carteira_clientes ("codigo_pessoa", "razaosocial_pessoa", "cliente_pessoa", "grupo_pessoa", "descricao_grupo", "grupo_cliente_descricao") SELECT "codigo_pessoa", "razaosocial_pessoa", "cliente_pessoa", "grupo_pessoa", "descricao_grupo", "grupo_cliente_descricao" FROM dw.carga_carteira;

DELETE FROM dw.metas_consultores;

INSERT INTO dw.metas_consultores ("autoinc_metasven", "empresa_metasven", "tipo_metasven", "tipodoc_metasven", "ano_metasven", "codigo_metasven", "razaosocial_pessoa", "metaporlinha_consven", "metaporgrupo_consven", "metaportipoproduto_consven", "metaporregiao_consven", "metaporunidfabril_consven", "metapororigem_consven", "metaporsupervisor_consven", "metaporconsultor_consven", "meta_01_metasven", "meta_02_metasven", "meta_03_metasven", "meta_04_metasven", "meta_05_metasven", "meta_06_metasven", "meta_07_metasven", "meta_08_metasven", "meta_09_metasven", "meta_10_metasven", "meta_11_metasven", "meta_12_metasven", "datahorainclusao_metasven", "usuarioinclusao_metasven", "datahoraalteracao_metasven", "usuarioalteracao_metasven") SELECT "autoinc_metasven", "empresa_metasven", "tipo_metasven", "tipodoc_metasven", "ano_metasven", "codigo_metasven", "razaosocial_pessoa", "metaporlinha_consven", "metaporgrupo_consven", "metaportipoproduto_consven", "metaporregiao_consven", "metaporunidfabril_consven", "metapororigem_consven", "metaporsupervisor_consven", "metaporconsultor_consven", "meta_01_metasven", "meta_02_metasven", "meta_03_metasven", "meta_04_metasven", "meta_05_metasven", "meta_06_metasven", "meta_07_metasven", "meta_08_metasven", "meta_09_metasven", "meta_10_metasven", "meta_11_metasven", "meta_12_metasven", "datahorainclusao_metasven", "usuarioinclusao_metasven", "datahoraalteracao_metasven", "usuarioalteracao_metasven" FROM dw.carga_metas;

UPDATE etl.execucao_carga SET status='publicado',fim=now(),contagens=jsonb_build_object('abertos', (SELECT count(*) FROM dw.carga_abertos), 'emitidos', (SELECT count(*) FROM dw.carga_emitidos), 'faturados', (SELECT count(*) FROM dw.carga_faturados), 'carteira', (SELECT count(*) FROM dw.carga_carteira), 'metas', (SELECT count(*) FROM dw.carga_metas)) WHERE id='${ETL_RUN_ID}' AND status='executando';

COMMIT;</sql>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <GUI>
      <xloc>360</xloc>
      <yloc>180</yloc>
    </GUI>
  </transform>
</pipeline>