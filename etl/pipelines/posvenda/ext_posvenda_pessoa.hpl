<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>ext_posvenda_pessoa</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Espelho bruto do recorte de pós-venda de PESSOA; indicadores calculados no PostgreSQL.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/13 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/13 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler Firebird (dados brutos)</from>
      <to>Gravar staging (dados brutos)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Gravar staging (dados brutos)</name>
    <type>TableOutput</type>
    <custom_select>N</custom_select>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <add_columns>N</add_columns>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <auto_update_table_structure>N</auto_update_table_structure>
    <change_column_types>N</change_column_types>
    <commit>1000</commit>
    <connection>DW</connection>
    <drop_columns>N</drop_columns>
    <fields>
      <field>
        <column_name>codigo_pessoa</column_name>
        <stream_name>CODIGO_PESSOA</stream_name>
      </field>
      <field>
        <column_name>razaosocial_pessoa</column_name>
        <stream_name>RAZAOSOCIAL_PESSOA</stream_name>
      </field>
      <field>
        <column_name>grupo_pessoa</column_name>
        <stream_name>GRUPO_PESSOA</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>posvenda_stage</schema>
    <specify_fields>Y</specify_fields>
    <table>pessoa</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ler Firebird (dados brutos)</name>
    <type>TableInput</type>
    <custom_select>N</custom_select>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>DADOS</connection>
    <execute_each_row>N</execute_each_row>
    <limit />
    <sql>SELECT CODIGO_PESSOA, RAZAOSOCIAL_PESSOA, GRUPO_PESSOA FROM PESSOA WHERE CODIGO_PESSOA IN (SELECT CLIENTE_DOCFAT FROM DOCUMENTO_FATURA WHERE CODIGO_DOCFAT IN (SELECT CODIGO_DOCFAT FROM DOCUMENTO_FATURA WHERE CODIGO_DOCFAT IN (SELECT CODIGO_DOCFAT FROM DOCUMENTO_FATURA WHERE DTEMISSAO_DOCFAT &gt;= '${AFTERSALES_START_DATE}' AND DTEMISSAO_DOCFAT &lt; DATEADD(1 DAY TO CAST('${AFTERSALES_REFERENCE_DATE}' AS DATE)) AND ENTREGA_DOCFAT='N' AND ((TIPO_DOCFAT=2 AND OPCAO_DOCFAT=1) OR (TIPO_DOCFAT IN (1,2) AND OPCAO_DOCFAT IN (2,4)))) OR CODIGO_DOCFAT IN (SELECT di.DOCUMENTO_DOCITEM FROM DOCUMENTO_DEVOLUCAOCANCELA v JOIN DOCUMENTO_ITEM_DETALHE i ON i.AUTOINC_DOCITEMDET=v.AUTOINCITEMDETDOC_DOCDEV JOIN DOCUMENTO_ITEM di ON di.AUTOINC_DOCITEM=i.AUTOINCITEM_DOCITEMDET WHERE v.DOCUMENTO_DOCDEV IN (SELECT CODIGO_DOCFAT FROM DOCUMENTO_FATURA WHERE DTEMISSAO_DOCFAT &gt;= '${AFTERSALES_START_DATE}' AND DTEMISSAO_DOCFAT &lt; DATEADD(1 DAY TO CAST('${AFTERSALES_REFERENCE_DATE}' AS DATE)) AND ENTREGA_DOCFAT='N' AND ((TIPO_DOCFAT=2 AND OPCAO_DOCFAT=1) OR (TIPO_DOCFAT IN (1,2) AND OPCAO_DOCFAT IN (2,4))))) OR CODIGO_DOCFAT IN (SELECT di.DOCUMENTO_DOCITEM FROM DOCUMENTO_ENTREGA_DEVCAN v JOIN DOCUMENTO_ENTREGA t ON t.AUTOINC_DOCENT=v.AUTOINCDOCENT_DOCENTDEV JOIN DOCUMENTO_ITEM_DETALHE i ON i.AUTOINC_DOCITEMDET=t.AUTOINCITEMDETDOC_DOCENT JOIN DOCUMENTO_ITEM di ON di.AUTOINC_DOCITEM=i.AUTOINCITEM_DOCITEMDET WHERE v.DOCUMENTO_DOCENTDEV IN (SELECT CODIGO_DOCFAT FROM DOCUMENTO_FATURA WHERE DTEMISSAO_DOCFAT &gt;= '${AFTERSALES_START_DATE}' AND DTEMISSAO_DOCFAT &lt; DATEADD(1 DAY TO CAST('${AFTERSALES_REFERENCE_DATE}' AS DATE)) AND ENTREGA_DOCFAT='N' AND ((TIPO_DOCFAT=2 AND OPCAO_DOCFAT=1) OR (TIPO_DOCFAT IN (1,2) AND OPCAO_DOCFAT IN (2,4)))))))</sql>
    <variables_active>Y</variables_active>
    <attributes />
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>