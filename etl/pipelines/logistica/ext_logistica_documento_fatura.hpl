<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>ext_logistica_documento_fatura</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Campos brutos de DOCUMENTO_FATURA no recorte de pedidos abertos; sem cálculo de indicadores.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/13 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/13 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler Firebird (dados brutos)</from>
      <to>Gravar staging (dados brutos)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Gravar staging (dados brutos)</name>
    <type>TableOutput</type>
    <custom_select>N</custom_select>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <add_columns>N</add_columns>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <auto_update_table_structure>N</auto_update_table_structure>
    <change_column_types>N</change_column_types>
    <commit>1000</commit>
    <connection>DW</connection>
    <drop_columns>N</drop_columns>
    <fields>
      <field>
        <column_name>codigo_docfat</column_name>
        <stream_name>CODIGO_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>empresa_docfat</column_name>
        <stream_name>EMPRESA_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>dtemissao_docfat</column_name>
        <stream_name>DTEMISSAO_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>tipo_docfat</column_name>
        <stream_name>TIPO_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>opcao_docfat</column_name>
        <stream_name>OPCAO_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>entrega_docfat</column_name>
        <stream_name>ENTREGA_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>dataentrega_docfat</column_name>
        <stream_name>DATAENTREGA_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>dtsaida_docfat</column_name>
        <stream_name>DTSAIDA_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>cliente_docfat</column_name>
        <stream_name>CLIENTE_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>localentrega_docfat</column_name>
        <stream_name>LOCALENTREGA_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>status_docfat</column_name>
        <stream_name>STATUS_DOCFAT</stream_name>
      </field>
      <field>
        <column_name>entregarmercadoria_docfat</column_name>
        <stream_name>ENTREGARMERCADORIA_DOCFAT</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>logistica_stage</schema>
    <specify_fields>Y</specify_fields>
    <table>documento_fatura</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ler Firebird (dados brutos)</name>
    <type>TableInput</type>
    <custom_select>N</custom_select>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>DADOS</connection>
    <execute_each_row>N</execute_each_row>
    <limit />
    <sql>SELECT CODIGO_DOCFAT, EMPRESA_DOCFAT, DTEMISSAO_DOCFAT, TIPO_DOCFAT, OPCAO_DOCFAT, ENTREGA_DOCFAT, DATAENTREGA_DOCFAT, DTSAIDA_DOCFAT, CLIENTE_DOCFAT, LOCALENTREGA_DOCFAT, STATUS_DOCFAT, ENTREGARMERCADORIA_DOCFAT FROM DOCUMENTO_FATURA WHERE CODIGO_DOCFAT IN (SELECT d.CODIGO_DOCFAT FROM DOCUMENTO_FATURA d JOIN DOCUMENTO_ITEM di ON di.DOCUMENTO_DOCITEM=d.CODIGO_DOCFAT JOIN DOCUMENTO_ITEM_DETALHE i ON i.AUTOINCITEM_DOCITEMDET=di.AUTOINC_DOCITEM WHERE d.DTEMISSAO_DOCFAT &gt;= '${LOGISTICS_START_DATE}' AND d.DTEMISSAO_DOCFAT &lt; DATEADD(1 DAY TO CAST('${LOGISTICS_REFERENCE_DATE}' AS DATE))
AND d.TIPO_DOCFAT=1 AND d.OPCAO_DOCFAT=1 AND d.ENTREGA_DOCFAT='N'
AND di.AUTOINC_DOCITEM=di.COMPOSICAOITEM_DOCITEM AND di.TIPO_DOCITEM IN (1,4)
AND i.QTDEABERTA_DOCITEMDET&gt;0)</sql>
    <variables_active>Y</variables_active>
    <attributes />
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>