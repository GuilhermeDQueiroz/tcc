<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>ext_logistica_carga</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Campos brutos de CARGA no recorte de pedidos abertos; sem cálculo de indicadores.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/13 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/13 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler Firebird (dados brutos)</from>
      <to>Gravar staging (dados brutos)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Gravar staging (dados brutos)</name>
    <type>TableOutput</type>
    <custom_select>N</custom_select>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <add_columns>N</add_columns>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <auto_update_table_structure>N</auto_update_table_structure>
    <change_column_types>N</change_column_types>
    <commit>1000</commit>
    <connection>DW</connection>
    <drop_columns>N</drop_columns>
    <fields>
      <field>
        <column_name>codigo_carga</column_name>
        <stream_name>CODIGO_CARGA</stream_name>
      </field>
      <field>
        <column_name>empresa_carga</column_name>
        <stream_name>EMPRESA_CARGA</stream_name>
      </field>
      <field>
        <column_name>dtemissao_carga</column_name>
        <stream_name>DTEMISSAO_CARGA</stream_name>
      </field>
      <field>
        <column_name>datainicio_separacao_carga</column_name>
        <stream_name>DATAINICIO_SEPARACAO_CARGA</stream_name>
      </field>
      <field>
        <column_name>data_separacao_carga</column_name>
        <stream_name>DATA_SEPARACAO_CARGA</stream_name>
      </field>
      <field>
        <column_name>datainicio_conferencia_carga</column_name>
        <stream_name>DATAINICIO_CONFERENCIA_CARGA</stream_name>
      </field>
      <field>
        <column_name>data_conferencia_carga</column_name>
        <stream_name>DATA_CONFERENCIA_CARGA</stream_name>
      </field>
      <field>
        <column_name>datahorafechamento_carga</column_name>
        <stream_name>DATAHORAFECHAMENTO_CARGA</stream_name>
      </field>
      <field>
        <column_name>datahoralib_saida_carga</column_name>
        <stream_name>DATAHORALIB_SAIDA_CARGA</stream_name>
      </field>
      <field>
        <column_name>descricao_carga</column_name>
        <stream_name>DESCRICAO_CARGA</stream_name>
      </field>
      <field>
        <column_name>dtprevisaofaturamento_carga</column_name>
        <stream_name>DTPREVISAOFATURAMENTO_CARGA</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>logistica_stage</schema>
    <specify_fields>Y</specify_fields>
    <table>carga</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ler Firebird (dados brutos)</name>
    <type>TableInput</type>
    <custom_select>N</custom_select>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>DADOS</connection>
    <execute_each_row>N</execute_each_row>
    <limit />
    <sql>SELECT CODIGO_CARGA, EMPRESA_CARGA, DTEMISSAO_CARGA, DATAINICIO_SEPARACAO_CARGA, DATA_SEPARACAO_CARGA, DATAINICIO_CONFERENCIA_CARGA, DATA_CONFERENCIA_CARGA, DATAHORAFECHAMENTO_CARGA, DATAHORALIB_SAIDA_CARGA, DESCRICAO_CARGA, DTPREVISAOFATURAMENTO_CARGA FROM CARGA WHERE CODIGO_CARGA IN (SELECT cd.CARGA_CARDOC FROM CARGA_DOCUMENTOS cd WHERE cd.AUTOINC_CARDOC IN (SELECT cd.AUTOINC_CARDOC FROM CARGA_DOCUMENTOS cd WHERE cd.AUTOINC_CARDOC IN (SELECT ci.AUTOINCCARDOC_CARITE FROM CARGA_ITENS ci WHERE ci.AUTOINC_CARITE IN (SELECT ci.AUTOINC_CARITE FROM CARGA_ITENS ci WHERE ci.AUTOINCITEMDETDOC_CARITE IN (SELECT i.AUTOINC_DOCITEMDET FROM DOCUMENTO_FATURA d
JOIN DOCUMENTO_ITEM di ON di.DOCUMENTO_DOCITEM=d.CODIGO_DOCFAT
JOIN DOCUMENTO_ITEM_DETALHE i ON i.AUTOINCITEM_DOCITEMDET=di.AUTOINC_DOCITEM WHERE d.DTEMISSAO_DOCFAT &gt;= '${LOGISTICS_START_DATE}' AND d.DTEMISSAO_DOCFAT &lt; DATEADD(1 DAY TO CAST('${LOGISTICS_REFERENCE_DATE}' AS DATE))
AND d.TIPO_DOCFAT=1 AND d.OPCAO_DOCFAT=1 AND d.ENTREGA_DOCFAT='N'
AND di.AUTOINC_DOCITEM=di.COMPOSICAOITEM_DOCITEM AND di.TIPO_DOCITEM IN (1,4)
AND i.QTDEABERTA_DOCITEMDET&gt;0)))))</sql>
    <variables_active>Y</variables_active>
    <attributes />
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>